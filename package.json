{
  "name": "dynamic-island",
  "productName": "Dynamic Isle",
  "version": "0.3.0",
  "description": "An island at the top of your Windows screen: music, calendar, timers, AI agent status and quick tools.",
  "author": "Vraj93",
  "homepage": "https://github.com/Vraj93/dynamic-island-windows",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:store": "electron-builder --win appx --x64",
    "connect-claude": "node scripts/claude-hooks.js connect",
    "disconnect-claude": "node scripts/claude-hooks.js disconnect",
    "claude-status": "node scripts/claude-hooks.js status"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.vraj93.dynamicisland",
    "productName": "Dynamic Isle",
    "copyright": "Copyright © 2026 Vraj93",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "ui/**",
      "assets/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "electron/*.ps1",
      "electron/hooks/**",
      "scripts/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dynamic-Isle-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "shortcutName": "Dynamic Isle",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "appx": {
      "displayName": "Dynamic Isle",
      "publisherDisplayName": "Vraj",
      "applicationId": "DynamicIsle",
      "identityName": "Vraj.DynamicIsle",
      "publisher": "CN=9B187EAB-7CDA-4073-9840-7AF10C30DE82",
      "backgroundColor": "#000000",
      "languages": [
        "en-US"
      ],
      "addAutoLaunchExtension": true,
      "customExtensionsPath": "build/appx-extensions.xml",
      "customManifestPath": "build/appxmanifest.xml",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    },
    "afterPack": "build/after-pack.js"
  }
}
