        <!-- Store version: a short command name, so AI agents and scripts can run the app's hook mode
             ("dynamicisle --island ...") even though Store apps live in a protected folder. -->
        <uap3:Extension xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
          Category="windows.appExecutionAlias" Executable="app\Dynamic Isle.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="dynamicisle.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
